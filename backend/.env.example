# =====================================================================
# Student Activity Attendance System - Environment Variables Example
# Duplicate this file as '.env' and customize values for your deployment.
# NEVER commit the real '.env' file to version control!
# =====================================================================

# Application Settings
APP_NAME=Student Activity Attendance
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# Local SQLite example:
DATABASE_URL=sqlite:///./attendance.db
# PostgreSQL example:
# DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<dbname>

# QR Code & Session Security (Time in seconds)
QR_TOKEN_EXPIRE_SECONDS=30
CHECKIN_SESSION_EXPIRE_SECONDS=180

# Initial Admin Bootstrap (Optional for initial setup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-admin-password-here
